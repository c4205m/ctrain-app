    {"id": "mt-09", "name": "Medial rotation", "description": "Rotating a body part inward, toward the center/midline (internal rotation)"},
    {"id": "mt-10", "name": "Lateral rotation", "description": "Rotating a body part outward, away from the center/midline (external rotation)"},
